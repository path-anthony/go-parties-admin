# Railway Postgres connection string. Never commit the real value.
DATABASE_URL="postgresql://user:password@host:port/database"

# Claude API key, used by the /api/recommend endpoint. Never commit the real value.
ANTHROPIC_API_KEY="sk-ant-..."

# Port for the Express API server.
PORT=3001

# Shared admin password. One password for the whole admin UI and API, no
# per-user accounts. Required; the server refuses to start without it.
ADMIN_PASSWORD="change-me"

# Signs the admin and customer session cookies. Its own value, never the
# admin password: the server refuses to start if it is missing or equal to
# ADMIN_PASSWORD. Rotating it signs every existing session out. Use a long
# random string, e.g. `openssl rand -base64 48`. Never commit the real value.
COOKIE_SECRET="change-me-as-well"

# Extra origins allowed to make credentialed cross-origin requests to this
# API (comma-separated, no trailing slashes), e.g. the deployed go-parties-app
# customer site: ALLOWED_ORIGINS="https://parties.thegoeventgroup.com"
# localhost (any port) is always allowed and doesn't need to be listed here.
ALLOWED_ORIGINS=

# Shared secret n8n sends in the X-Webhook-Secret header when posting
# website leads to POST /api/leads/external. Separate from ADMIN_PASSWORD
# on purpose: rotating one shouldn't break the other. The endpoint refuses
# every request (503) until this is set. Never commit the real value.
N8N_WEBHOOK_SECRET="change-me-too"
