# Railway Postgres connection string. Never commit the real value.
DATABASE_URL="postgresql://user:password@host:port/database"

# Claude API key, used by the /api/recommend endpoint. Never commit the real value.
ANTHROPIC_API_KEY="sk-ant-..."

# Port for the Express API server.
PORT=3001

# Shared admin password. One password for the whole admin UI and API —
# no per-user accounts. Required; the server refuses to start without it.
# Rotating this value also invalidates every existing session, since
# sessions are signed with this same value (see server/auth.ts).
ADMIN_PASSWORD="change-me"
