generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every row belongs to an Account. Only one Account exists today (The Go
// Event Group), but Item is scoped to it from day one so multi-tenancy is
// a query filter later, not a migration.
model Account {
  id                        String   @id @default(cuid())
  name                      String
  email                     String   @unique
  createdAt                 DateTime @default(now()) @map("created_at")
  // Rush orders. A booking whose event starts less than this many hours
  // from now is flagged rush when it is made or rescheduled. The contact
  // number is what the storefront shows a customer booking inside that
  // window; null until a real one is set in Settings.
  minBookingNoticeHours     Int      @default(72) @map("min_booking_notice_hours")
  rushContactPhone          String?  @map("rush_contact_phone")
  // Review routing. A booking whose total is over fullReviewThreshold, or
  // whose occasion is in reviewOccasions (a group like Wedding, or a single
  // sub-occasion), does not become a Held booking: it becomes a
  // DesignRequest for staff to look at first.
  fullReviewThreshold       Decimal  @default(15000) @map("full_review_threshold") @db.Decimal(10, 2)
  reviewOccasions           String[] @default(["Wedding", "Corporate"]) @map("review_occasions")
  // Share of the total taken as the deposit. One global value for now.
  depositPercentage         Decimal  @default(20) @map("deposit_percentage") @db.Decimal(5, 2)
  // Days before the event after which a cancellation is no longer free. One
  // global value for now; recorded only, nothing enforces it yet.
  cancellationWindowDays    Int      @default(5) @map("cancellation_window_days")
  // Who is told when a contract is signed. Either can be empty; a missing
  // one is logged as skipped, not an error.
  staffNotifyPhone          String?  @map("staff_notify_phone")
  staffNotifyEmail          String?  @map("staff_notify_email")
  // The balance reminder check looks at events starting within this many
  // days. POST /api/automations/check-reminders may override it per call.
  balanceReminderWindowDays Int      @default(7) @map("balance_reminder_window_days")
  // GO's side of a signed contract: who signs for the company. When both are
  // set, the signed PDF carries a second signature block for them; when
  // either is empty, no block is drawn.
  authorizedSignerName      String?  @map("authorized_signer_name")
  authorizedSignerTitle     String?  @map("authorized_signer_title")
  // Off until the storefront sends the agreement checkbox. While off, a
  // storefront booking that arrives without it is still recorded, with the
  // checkbox marked unchecked; on, it is refused.
  requireAgreementCheckbox  Boolean  @default(false) @map("require_agreement_checkbox")

  items             Item[]
  leads             Lead[]
  leadStatuses      LeadStatus[]
  bookings          Booking[]
  customers         Customer[]
  packages          Package[]
  crewMembers       CrewMember[]
  gigs              Gig[]
  sessions          Session[]
  skills            Skill[]
  policyVersions    PolicyVersion[]
  agreements        Agreement[]
  designRequests    DesignRequest[]
  contractDocuments ContractDocument[]
  messageLogs       MessageLog[]
  messageTemplates  MessageTemplate[]

  @@map("accounts")
}

// The crew skills an account uses, managed in Settings. Item.skills,
// CrewMember.skills and Gig.skill hold names from here as plain strings
// (a rename rewrites them all in one transaction); a skill can't be
// deleted while an item or a crew member still lists it.
model Skill {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, name])
  @@index([accountId, position])
  @@map("skills")
}

// One signed-in session, admin or customer. The cookie carries only this
// row's id (a random token, signed so it can't be tampered with in
// transit), and every gated request looks the row up: a deleted row is a
// revoked session, whatever the cookie still says and however long it has
// left. Logout deletes the row; expired rows are swept on the next login.
// kind is "admin" or "customer"; customerId is set only for the latter,
// and a deleted customer takes their sessions with them.
model Session {
  id         String   @id
  accountId  String   @map("account_id")
  kind       String
  customerId String?  @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  account  Account   @relation(fields: [accountId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("sessions")
}

// A person who works events: a DJ, a photographer, a coordinator. Admin
// managed only, no login. skills holds names from the fixed list in
// server/skills.ts (plain strings validated at the API, like every other
// fixed set here, so adding a skill is a code change, not a migration).
// Deactivating keeps the row and its history; it just stops the person
// being offered new gigs.
model CrewMember {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  phone     String?
  email     String?
  skills    String[] @default([])
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  account Account    @relation(fields: [accountId], references: [id])
  filled  Gig[]      @relation("GigFilledBy")
  offers  GigOffer[]

  @@index([accountId, active])
  @@map("crew_members")
}

// One person needed for one service item on one booking. Created
// automatically when a booking takes an item with a required skill (one
// gig per unit of it), cancelled with the booking, moved with the
// booking's date. itemName is copied so the gig still reads right if the
// item is renamed or deleted. status: Needs Crew, Offered, Filled,
// Cancelled. filledById is the crew member whose offer was accepted.
model Gig {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  bookingId  String   @map("booking_id")
  itemId     String?  @map("item_id")
  itemName   String   @map("item_name")
  skill      String
  eventDate  DateTime @map("event_date") @db.Date
  status     String   @default("Needs Crew")
  filledById String?  @map("filled_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  account  Account     @relation(fields: [accountId], references: [id])
  booking  Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item     Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  filledBy CrewMember? @relation("GigFilledBy", fields: [filledById], references: [id], onDelete: SetNull)
  offers   GigOffer[]

  @@index([accountId, status])
  @@index([bookingId])
  @@index([accountId, skill, eventDate])
  @@map("gigs")
}

// A gig put to one crew member. status: Sent, Accepted, Declined. Several
// people can be offered the same gig; one accepted offer fills it.
model GigOffer {
  id           String   @id @default(cuid())
  gigId        String   @map("gig_id")
  crewMemberId String   @map("crew_member_id")
  status       String   @default("Sent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  gig        Gig        @relation(fields: [gigId], references: [id], onDelete: Cascade)
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@unique([gigId, crewMemberId])
  @@map("gig_offers")
}

// The Leads board's columns, editable in Settings. Lead.status stores
// the column's name and is a real foreign key onto (account_id, name):
// renaming a column cascades to its leads at the database level, and
// deleting one that still has leads is refused by the database too (the
// API checks first so the message is a useful one). New leads go to the
// column with the lowest position.
model LeadStatus {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  leads   Lead[]

  @@unique([accountId, name])
  @@index([accountId, position])
  @@map("lead_statuses")
}

// Append-only log of what happened with a lead. No edits, no deletes.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// A Unit is one physical instance of an Item (GO-PRODUCT.md: items are the
// menu, units are the warehouse). Optional per item: only items GO tracks
// as distinct physical pieces get rows here. Scoped to an account through
// its item. status is a manual flag for now (Available, Booked,
// Maintenance), validated at the API; real availability will come from
// BookingUnit once a calendar exists.
model Unit {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  label     String
  status    String   @default("Available")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  item     Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bookings BookingUnit[]

  @@index([itemId])
  @@map("units")
}

// An event on a real date. leadId is optional: a booking can be
// taken over the phone without a tracked lead behind it, and deleting a
// lead leaves the booking in place. status is the stage set by hand: Held
// (the default), Contract Sent, Signed, Completed or Cancelled. The status
// people read is computed from it and retainerPaid (src/lib/bookingStatus.ts):
// Confirmed is never stored, it is Signed with the retainer paid. Validated at the API.
//
// phone and email are both required for new bookings at the API, but the
// columns are nullable: rows from before the split had one free-text
// contact value, which the migration sorted into whichever field it
// matched and left the other empty rather than guessing.
model Booking {
  id                       String    @id @default(cuid())
  accountId                String    @map("account_id")
  leadId                   String?   @map("lead_id")
  eventDate                DateTime  @map("event_date") @db.Date
  // Free text like "2 PM" or "noon to 4"; not parsed, the calendar pass
  // decides what to do with it.
  eventTime                String?   @map("event_time")
  address                  String?
  customerName             String    @map("customer_name")
  phone                    String?
  email                    String?
  status                   String    @default("Held")
  // The retainer has been paid. Replaces the old deposit_paid flag, since dropped. Nothing
  // sets it automatically yet; the admin ticks it by hand.
  retainerPaid             Boolean   @default(false) @map("retainer_paid")
  // Set when the booking was made, or moved, inside the account's minimum
  // notice window. Visibility only: it never blocks or changes a booking.
  rush                     Boolean   @default(false)
  // The occasion it was booked for (a group like Wedding or a sub-occasion),
  // when the customer or staff said. Null for older bookings.
  occasion                 String?
  // How the balance will be collected. Recorded only: nothing charges or
  // sends anything yet. Manual, Auto-charge or Reminder link, validated at
  // the API.
  balancePaymentPreference String    @default("Manual") @map("balance_payment_preference")
  // The balance (total less the deposit) has been paid. Ticked by hand. The
  // reminder check skips bookings where it is true.
  balancePaid              Boolean   @default(false) @map("balance_paid")
  // When the reminder check last messaged the customer about the balance.
  lastBalanceReminderAt    DateTime? @map("last_balance_reminder_at")
  // Set when the booking was made from a logged-in customer account; null
  // for admin-entered and anonymous storefront bookings. Deleting the
  // account keeps the booking.
  customerId               String?   @map("customer_id")
  // Set when the booking came from a published package. The package's
  // bundle price is then the total, and its item quantities decide how
  // many units are held. Deleting the package keeps the booking.
  packageId                String?   @map("package_id")
  // What the customer was quoted, as a number of dollars: the package's
  // bundle price, or the item prices times quantity for a direct booking.
  // Null for admin-entered bookings, which carry no price yet.
  total                    Decimal?  @db.Decimal(10, 2)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id])
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  package       Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  units         BookingUnit[]
  addons        BookingAddon[]
  gigs          Gig[]
  agreement     Agreement?
  designRequest DesignRequest?

  @@index([accountId, eventDate])
  @@index([leadId])
  @@index([customerId])
  @@index([packageId])
  @@map("bookings")
}

// A customer login for self-service booking management. Password-based
// only: passwordHash is bcrypt, never plaintext. phone and email are
// stored normalized (digits only; lowercased) and unique per account.
// phoneVerifiedAt is structural prep for an SMS verification step that
// isn't built; nothing sets it today. name is optional at signup and is
// remembered from the first booking made while logged in.
model Customer {
  id              String    @id @default(cuid())
  accountId       String    @map("account_id")
  name            String?
  phone           String
  email           String
  passwordHash    String    @map("password_hash")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  account    Account     @relation(fields: [accountId], references: [id])
  bookings   Booking[]
  sessions   Session[]
  agreements Agreement[]

  @@unique([accountId, phone])
  @@unique([accountId, email])
  @@map("customers")
}

// A Package is a curated bundle of real catalog items with one manual
// price (not a sum; the gap is Andy's discount). occasions are the
// storefront sub-occasion strings the package is offered under (one or
// more; publishing needs at least one). keywords are short customer-facing
// search terms, suggested by Claude from the package's contents and
// edited by the admin before saving. status is Draft or Published,
// validated at the API; only Published packages are public.
model Package {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  status      String   @default("Draft")
  keywords    String[] @default([])
  occasions   String[] @default([])
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  account  Account       @relation(fields: [accountId], references: [id])
  items    PackageItem[]
  bookings Booking[]

  @@index([accountId, status])
  @@map("packages")
}

model PackageItem {
  packageId String @map("package_id")
  itemId    String @map("item_id")
  quantity  Int    @default(1)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([packageId, itemId])
  @@index([itemId])
  @@map("package_items")
}

// Which physical units are committed to which booking. eventDate is copied
// from the booking on purpose: the unique constraint on (unitId, eventDate)
// is what makes double-booking impossible at the database level, no matter
// which code path tries. Every writer keeps the copy in sync (see
// server/routes/bookings.ts and directBookings.ts), and a cancelled booking
// releases its rows so the constraint doesn't hold dates hostage.
model BookingUnit {
  bookingId String   @map("booking_id")
  unitId    String   @map("unit_id")
  eventDate DateTime @map("event_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([bookingId, unitId])
  @@unique([unitId, eventDate])
  @@map("booking_units")
}

model Item {
  id               String   @id @default(cuid())
  accountId        String   @map("account_id")
  name             String
  category         String
  price            Decimal? @db.Decimal(10, 2)
  // How the price reads to a customer. One of the fixed choices in
  // src/lib/itemFields.ts, or a short "Other" text (30 characters at most),
  // validated at the API. It is customer-facing, so nothing internal goes
  // here; that is what source and needsPriceReview are for.
  priceUnit        String?  @map("price_unit")
  // Where the item comes from: Owned or Partner-sourced. Admin only.
  source           String   @default("Owned")
  // Internal flag: the price came from a supplier and still needs a human
  // look. Admin only, never in a public response.
  needsPriceReview Boolean  @default(false) @map("needs_price_review")
  notes            String?
  photoUrl         String?  @map("photo_url")
  // The crew skills this item needs to run, from the fixed list in
  // server/skills.ts (plain strings, like CrewMember.skills). Empty for
  // most physical items. Independent of units: an item can be a physical
  // piece with units, a service with skills, or both (a cigar bar that is
  // a real setup and needs waitstaff and a bartender). Booking it creates
  // one Gig per skill per unit wanted, on top of any unit it holds.
  skills           String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id])
  units         Unit[]
  packageItems  PackageItem[]
  addonGroups   AddonGroup[]
  bookingAddons BookingAddon[]
  gigs          Gig[]

  @@index([accountId])
  @@map("items")
}

// Item-specific configuration. A group is one question about an item
// ("Flavor", "Print size") and its addons are the answers. A booking picks
// at most one addon per group; a required group must be answered for the
// item to be booked, an optional one is an upgrade that can be skipped.
// position keeps groups and options in the order Andy arranged them.
model AddonGroup {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  name      String
  required  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  item   Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  addons Addon[]

  @@index([itemId, position])
  @@map("addon_groups")
}

// priceDelta is added to the item's price when the option is picked. Zero
// is a free choice (a flavor) and a negative number is a downgrade, so it
// is not constrained to upsells.
model Addon {
  id           String   @id @default(cuid())
  addonGroupId String   @map("addon_group_id")
  name         String
  priceDelta   Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  group    AddonGroup     @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  bookings BookingAddon[]

  @@index([addonGroupId, position])
  @@map("addons")
}

// What a booking actually chose. The names and the price delta are copied
// at booking time on purpose: a booking is a record of what was sold, so
// renaming, repricing, or deleting an option later must not rewrite it.
// itemId and addonId still point at the live rows while they exist.
// quantity is how many units of the item the option applies to (more than
// one only for a package that holds several of the same item).
model BookingAddon {
  id         String   @id @default(cuid())
  bookingId  String   @map("booking_id")
  itemId     String?  @map("item_id")
  addonId    String?  @map("addon_id")
  itemName   String   @map("item_name")
  groupName  String   @map("group_name")
  addonName  String   @map("addon_name")
  priceDelta Decimal  @map("price_delta") @db.Decimal(10, 2)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  addon   Addon?  @relation(fields: [addonId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_addons")
}

// A lead is the top of the CRM pipeline (see GO-PRODUCT.md: Booking,
// Client, Contract, Payment sit on top of this). Two ways in today:
// - "ask-go": captured from /api/recommend when a storefront conversation
//   commits to a recommendation. Anonymous, so no customer fields; theme
//   and itemsReturned hold what was asked and what came back.
// - "manual": entered by hand in the admin. Has customer fields, no
//   Ask GO data.
// - "website": posted by the n8n automation on the marketing site.
// - "storefront": created alongside a direct single-item booking from the
//   customer app (see server/routes/directBookings.ts); the Booking row
//   points back at it through leadId.
// status and source are plain strings validated at the API boundary
// (see server/routes/leads.ts) rather than Postgres enums, so adding a
// value later is a code change, not a migration.
model Lead {
  id             String    @id @default(cuid())
  accountId      String    @map("account_id")
  // Name of a LeadStatus row on the same account (see statusRef).
  status         String
  source         String    @default("ask-go")
  // Position within its status column on the Leads board. New rows and
  // dropdown status changes get 0, which sorts them into the top group
  // (ties broken newest first); a drag renumbers the whole target column.
  sortOrder      Int       @default(0) @map("sort_order")
  // Free-form labels, independent of status.
  tags           String[]  @default([])
  customerName   String?   @map("customer_name")
  contact        String?
  occasion       String?
  dateOfInterest DateTime? @map("date_of_interest") @db.Date
  notes          String?
  theme          String?
  itemsReturned  Json?     @map("items_returned")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  account    Account        @relation(fields: [accountId], references: [id])
  statusRef  LeadStatus     @relation(fields: [accountId, status], references: [accountId, name], onUpdate: Cascade, onDelete: Restrict)
  activities LeadActivity[]
  bookings   Booking[]

  @@index([accountId])
  @@index([accountId, status])
  @@map("leads")
}

// The cancellation and deposit policy text customers agree to. Saving a
// change never edits a row: it adds the next version, so an Agreement can
// always point at the exact text that was on screen when it was made.
model PolicyVersion {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  version   Int
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  account           Account            @relation(fields: [accountId], references: [id])
  agreements        Agreement[]
  contractDocuments ContractDocument[]

  @@unique([accountId, version])
  @@map("policy_versions")
}

// What a customer agreed to, and when. Belongs to exactly one booking or
// exactly one design request (a database check says so), and every new
// booking must have one by the time its transaction commits (a deferred
// constraint trigger says so). policyVersionId is the text they saw.
// checkboxChecked is what the customer actually did. The contract fields
// are reserved for the signed-contract integration and stay empty until it
// exists: provider, that provider's document id, its status, and a link.
model Agreement {
  id                 String   @id @default(cuid())
  accountId          String   @map("account_id")
  customerId         String?  @map("customer_id")
  bookingId          String?  @unique @map("booking_id")
  designRequestId    String?  @unique @map("design_request_id")
  policyVersionId    String   @map("policy_version_id")
  checkboxChecked    Boolean  @map("checkbox_checked")
  agreedAt           DateTime @default(now()) @map("agreed_at")
  contractProvider   String?  @map("contract_provider")
  contractExternalId String?  @map("contract_external_id")
  contractStatus     String?  @map("contract_status")
  contractUrl        String?  @map("contract_url")
  // The unguessable part of the signing link. Set when the contract is
  // issued to the customer.
  signingToken       String?  @unique @map("signing_token")
  createdAt          DateTime @default(now()) @map("created_at")

  account          Account           @relation(fields: [accountId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking          Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  designRequest    DesignRequest?    @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  policyVersion    PolicyVersion     @relation(fields: [policyVersionId], references: [id])
  contractDocument ContractDocument?

  @@index([policyVersionId])
  @@map("agreements")
}

// A submission that needs staff to look at it before anything is held:
// a cart over the review threshold, or one for an occasion on the review
// list. No unit or crew is locked. cart is a snapshot of what was asked
// for (items, quantities, chosen options, package), so it reads the same
// later. status: Open, Converted (a real booking was made from it, see
// bookingId) or Dismissed.
model DesignRequest {
  id                       String   @id @default(cuid())
  accountId                String   @map("account_id")
  status                   String   @default("Open")
  // Why it was routed here: threshold, occasion, or both.
  reasons                  String[] @default([])
  occasion                 String?
  eventDate                DateTime @map("event_date") @db.Date
  eventTime                String?  @map("event_time")
  address                  String?
  customerName             String   @map("customer_name")
  phone                    String?
  email                    String?
  customerId               String?  @map("customer_id")
  packageId                String?  @map("package_id")
  cart                     Json
  total                    Decimal? @db.Decimal(10, 2)
  balancePaymentPreference String   @default("Manual") @map("balance_payment_preference")
  notes                    String?
  bookingId                String?  @unique @map("booking_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  account   Account    @relation(fields: [accountId], references: [id])
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  agreement Agreement?

  @@index([accountId, status])
  @@map("design_requests")
}

// The signed contract, kept for good. One per agreement. The PDF itself is
// stored in the database (bytes), the same way photos are: the app has no
// persistent disk, so a file on the server would vanish at the next
// deploy. text is what the customer was shown and signed; sha256 is the
// fingerprint of the PDF. downloadToken is the unguessable part of the
// public link to it. Never edited after it is written.
model ContractDocument {
  id                String   @id @default(cuid())
  accountId         String   @map("account_id")
  agreementId       String   @unique @map("agreement_id")
  policyVersionId   String   @map("policy_version_id")
  downloadToken     String   @unique @map("download_token")
  text              String
  pdf               Bytes
  sha256            String
  signedName        String   @map("signed_name")
  consentElectronic Boolean  @map("consent_electronic")
  agreedToTerms     Boolean  @map("agreed_to_terms")
  signerIp          String?  @map("signer_ip")
  signerUserAgent   String?  @map("signer_user_agent")
  signedAt          DateTime @map("signed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  account       Account       @relation(fields: [accountId], references: [id])
  agreement     Agreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id])

  @@map("contract_documents")
}

// One line per message the system tried to send, SMS or email, plus what
// n8n later reported about it. The single place to see "did it go out".
// status is our own attempt: sent (handed to Twilio, or to the n8n email
// webhook), failed, or skipped-* (a setting or credential was missing, so
// nothing was attempted; never recorded as sent). confirmation is what
// n8n reported afterwards: delivered or failed. source: admin (we sent it)
// or n8n (a send n8n made itself and reported). The booking, request,
// crew and gig ids are plain references so the log survives deletions.
model MessageLog {
  id                 String    @id @default(cuid())
  accountId          String    @map("account_id")
  channel            String
  direction          String    @default("outbound")
  source             String    @default("admin")
  purpose            String
  recipient          String
  subject            String?
  body               String
  status             String
  error              String?
  providerRef        String?   @map("provider_ref")
  bookingId          String?   @map("booking_id")
  designRequestId    String?   @map("design_request_id")
  crewMemberId       String?   @map("crew_member_id")
  gigId              String?   @map("gig_id")
  // Which registry trigger this send belongs to (server/triggers.ts), and
  // its journey (lead, client, crew). Null on rows from before the pipeline
  // and on hand-typed messages, which are "manual_message".
  triggerKey         String?   @map("trigger_key")
  journey            String?
  leadId             String?   @map("lead_id")
  // One send per key. A key that already has a sent (or in-flight) row is
  // never sent again; one that was skipped, blocked or deferred is retried
  // by updating its own row.
  idempotencyKey     String?   @unique @map("idempotency_key")
  confirmation       String?
  confirmationAt     DateTime? @map("confirmation_at")
  confirmationDetail String?   @map("confirmation_detail")
  createdAt          DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([bookingId])
  @@index([triggerKey])
  @@map("message_logs")
}

// A customized message. Rows exist only when the admin changed something:
// edited wording (subject and body set) or switched a channel off
// (enabled false with null wording, meaning "use the default wording").
// No row means the registry default in server/triggers.ts and enabled.
// Reset to default deletes the row.
model MessageTemplate {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  triggerKey String   @map("trigger_key")
  channel    String
  subject    String?
  body       String?
  enabled    Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, triggerKey, channel])
  @@map("message_templates")
}
