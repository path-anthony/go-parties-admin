generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every row belongs to an Account. Only one Account exists today (The Go
// Event Group), but Item is scoped to it from day one so multi-tenancy is
// a query filter later, not a migration.
model Account {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  items        Item[]
  leads        Lead[]
  leadStatuses LeadStatus[]
  bookings     Booking[]

  @@map("accounts")
}

// The Leads board's columns, editable in Settings. Lead.status stores
// the column's name and is a real foreign key onto (account_id, name):
// renaming a column cascades to its leads at the database level, and
// deleting one that still has leads is refused by the database too (the
// API checks first so the message is a useful one). New leads go to the
// column with the lowest position.
model LeadStatus {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  leads   Lead[]

  @@unique([accountId, name])
  @@index([accountId, position])
  @@map("lead_statuses")
}

// Append-only log of what happened with a lead. No edits, no deletes.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// A Unit is one physical instance of an Item (GO-PRODUCT.md: items are the
// menu, units are the warehouse). Optional per item: only items GO tracks
// as distinct physical pieces get rows here. Scoped to an account through
// its item. status is a manual flag for now (Available, Booked,
// Maintenance), validated at the API; real availability will come from
// BookingUnit once a calendar exists.
model Unit {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  label     String
  status    String   @default("Available")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  item     Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bookings BookingUnit[]

  @@index([itemId])
  @@map("units")
}

// A confirmed event on a real date. leadId is optional: a booking can be
// taken over the phone without a tracked lead behind it, and deleting a
// lead leaves the booking in place. status is Confirmed, Completed, or
// Cancelled, validated at the API.
model Booking {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  leadId          String?  @map("lead_id")
  eventDate       DateTime @map("event_date") @db.Date
  customerName    String   @map("customer_name")
  customerContact String   @map("customer_contact")
  status          String   @default("Confirmed")
  // Placeholder for the deposit integration that isn't built yet. Nothing
  // sets this automatically; it's a flag Andy can tick by hand for now.
  depositPaid     Boolean  @default(false) @map("deposit_paid")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  account Account       @relation(fields: [accountId], references: [id])
  lead    Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  units   BookingUnit[]

  @@index([accountId, eventDate])
  @@index([leadId])
  @@map("bookings")
}

// Which physical units are committed to which booking. eventDate is copied
// from the booking on purpose: the unique constraint on (unitId, eventDate)
// is what makes double-booking impossible at the database level, no matter
// which code path tries. Every writer keeps the copy in sync (see
// server/routes/bookings.ts and directBookings.ts), and a cancelled booking
// releases its rows so the constraint doesn't hold dates hostage.
model BookingUnit {
  bookingId String   @map("booking_id")
  unitId    String   @map("unit_id")
  eventDate DateTime @map("event_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([bookingId, unitId])
  @@unique([unitId, eventDate])
  @@map("booking_units")
}

model Item {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  category  String
  price     Decimal? @db.Decimal(10, 2)
  priceUnit String?  @map("price_unit")
  notes     String?
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])
  units   Unit[]

  @@index([accountId])
  @@map("items")
}

// A lead is the top of the CRM pipeline (see GO-PRODUCT.md: Booking,
// Client, Contract, Payment sit on top of this). Two ways in today:
// - "ask-go": captured from /api/recommend when a storefront conversation
//   commits to a recommendation. Anonymous, so no customer fields; theme
//   and itemsReturned hold what was asked and what came back.
// - "manual": entered by hand in the admin. Has customer fields, no
//   Ask GO data.
// - "website": posted by the n8n automation on the marketing site.
// - "storefront": created alongside a direct single-item booking from the
//   customer app (see server/routes/directBookings.ts); the Booking row
//   points back at it through leadId.
// status and source are plain strings validated at the API boundary
// (see server/routes/leads.ts) rather than Postgres enums, so adding a
// value later is a code change, not a migration.
model Lead {
  id             String    @id @default(cuid())
  accountId      String    @map("account_id")
  // Name of a LeadStatus row on the same account (see statusRef).
  status         String
  source         String    @default("ask-go")
  // Position within its status column on the Leads board. New rows and
  // dropdown status changes get 0, which sorts them into the top group
  // (ties broken newest first); a drag renumbers the whole target column.
  sortOrder      Int       @default(0) @map("sort_order")
  // Free-form labels, independent of status.
  tags           String[]  @default([])
  customerName   String?   @map("customer_name")
  contact        String?
  occasion       String?
  dateOfInterest DateTime? @map("date_of_interest") @db.Date
  notes          String?
  theme          String?
  itemsReturned  Json?     @map("items_returned")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  account    Account        @relation(fields: [accountId], references: [id])
  statusRef  LeadStatus     @relation(fields: [accountId, status], references: [accountId, name], onUpdate: Cascade, onDelete: Restrict)
  activities LeadActivity[]
  bookings   Booking[]

  @@index([accountId])
  @@index([accountId, status])
  @@map("leads")
}
