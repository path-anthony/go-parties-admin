generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every row belongs to an Account. Only one Account exists today (The Go
// Event Group), but Item is scoped to it from day one so multi-tenancy is
// a query filter later, not a migration.
model Account {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  items Item[]
  leads Lead[]

  @@map("accounts")
}

model Item {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  category  String
  price     Decimal? @db.Decimal(10, 2)
  priceUnit String?  @map("price_unit")
  notes     String?
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("items")
}

// Raw captured interest from /api/recommend, the first piece of the CRM
// pipeline (see GO-PRODUCT.md: Booking, Client, Contract, Payment sit on
// top of this). No stage field yet — cold/warm/hot needs real follow-up
// tracking, which isn't built yet. This just records what was typed and
// what came back, every time, regardless of outcome.
model Lead {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  theme         String
  itemsReturned Json     @map("items_returned")
  createdAt     DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("leads")
}
